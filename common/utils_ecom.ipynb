    "def check_file_exists(path):\n",
    "    try:\n",
    "        files = dbutils.fs.ls(path)\n",
    "        return len(files) > 0\n",
    "    except Exception as e:\n",
    "        if 'CloudFileNotFoundException' in str(e) or 'No such file or directory' in str(e):\n",
    "            return False\n",
    "        else:\n",
    "            raise"
